# Optimized Dockerfile for Render deployment (CPU-only)
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install core requirements first (faster dependencies)
COPY requirements-core.txt .
RUN pip install --no-cache-dir -r requirements-core.txt

# Install ML requirements separately with CPU-only versions
COPY requirements-ml.txt .
# Install CPU-only versions of ML libraries for faster startup
RUN pip install --no-cache-dir \
    sentence-transformers==2.2.2 \
    scikit-learn==1.3.0 \
    numpy==1.24.3 \
    && pip install --no-cache-dir -r requirements-ml.txt || true

# Copy the rest of the application
COPY . .

# Make script files executable
RUN chmod +x startup.sh startup_optimized.sh
RUN find ./scripts -name "*.py" -exec chmod +x {} \; || true

# Set up environment variables for optimized performance
ENV PORT=8000 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    TF_CPP_MIN_LOG_LEVEL=3 \
    CUDA_VISIBLE_DEVICES="" \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

# Expose the port the app runs on
EXPOSE $PORT

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:$PORT/ || exit 1

# Command to run the application with optimized startup
CMD ["./startup_optimized.sh"]
