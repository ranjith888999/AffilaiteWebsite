# Environment Variables Template for Hostinger
# Copy this to .env and fill in your actual values

# Database Configuration (PostgreSQL on Hostinger)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=affiliate_website
DATABASE_USER=affiliate_user
DATABASE_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# Cuelinks API Configuration
CUELINKS_API_KEY=YOUR_CUELINKS_API_KEY_HERE
CUELINKS_BASE_URL=https://api.cuelinks.com/v1

# Application Security
SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE_GENERATE_RANDOM_STRING
DEBUG=False

# Domain Configuration
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
